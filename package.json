{
  "name": "transmute-core-workspace",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": ["website"],
  "scripts": {
    "check": "bash scripts/check.sh",
    "check:docs": "markdownlint-cli2 && bun scripts/check-docs.ts",
    "check:budget": "bun scripts/check-budget.ts",
    "check:web": "bun run --cwd website lint && bun run --cwd website typecheck && bun run --cwd website build",
    "test:web": "playwright test",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@mermaid-js/mermaid-cli": "11.12.0",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.11",
    "markdownlint-cli2": "0.21.0",
    "prettier": "3.8.1",
    "sharp": "0.34.5"
  }
}
