{
  "globs": ["**/*.md", "!node_modules/**", "!**/node_modules/**", "!**/build/**", "!**/.next/**", "!**/out/**", "!.website-studio/**", "!.flox/**", "!.cache/**", "!website/public/docs/**", "!**/.next-*/**", "!playwright-report/**", "!test-results/**"],
