{
  "name": "@transmute/website",
  "version": "0.1.0",
  "description": "Marketing website for Transmute Core game engine",
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "bun ../scripts/build-docs.ts && next build",
    "start": "PORT=3004 bun ../scripts/serve.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "next": "15.5.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.12",
    "typescript": "^5.3.3"
  },
  "private": true
}
